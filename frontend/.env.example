# ============================================================
# AUTHENTICATION CONFIGURATION
# ============================================================
# PRIMARY: Backend Authentication (Email/Password)
# SECONDARY: Firebase (Optional - Deprioritized)
# ============================================================

# Firebase Configuration (DEPRECATED - Now using backend authentication)
# Note: Firebase is currently deprioritized in favor of backend authentication
# This file is kept for backward compatibility only
# If Firebase integration is needed in the future, uncomment and fill in the values:

# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Backend Authentication (PRIMARY - Required)
# Configure the backend server URL
VITE_BACKEND_URL=http://localhost:8000

# Optional: Google Cloud Project ID (not currently used)
# VITE_FIREBASE_GOOGLE_CLIENT_ID=
